require "time"

APP_IDENTIFIER = "com.tidegames.tiderun"

def cert_limit_error?(error)
  error.message.to_s.match?(/already have.*distribution certificate|maximum.*certificat|certificate.*limit|maximum number of distribution/i)
end

def create_distribution_certificate!(api_key:, keychain_name:, keychain_pw:)
  cert_options = {
    api_key: api_key,
    generate_apple_certs: true,
    keychain_path: File.expand_path("~/Library/Keychains/#{keychain_name}-db"),
    keychain_password: keychain_pw
  }

  begin
    cert(**cert_options)
    return
  rescue StandardError => error
    raise unless cert_limit_error?(error)

    UI.important("Apple's Distribution certificate limit is full. Revoking the oldest valid Distribution certificate and retrying.")
  end

  distribution_types = [
    Spaceship::ConnectAPI::Certificate::CertificateType::DISTRIBUTION,
    Spaceship::ConnectAPI::Certificate::CertificateType::IOS_DISTRIBUTION
  ]

  # Apple's API currently rejects repeated certificateType query parameters,
  # so fetch the certificate list once and filter the Distribution types here.
  certificates = Spaceship::ConnectAPI::Certificate.all
  valid_certificates = certificates.select do |certificate|
    distribution_types.include?(certificate.certificate_type) && certificate.valid?
  end

  victim = valid_certificates.min_by do |certificate|
    begin
      Time.parse(certificate.expiration_date.to_s)
    rescue ArgumentError, TypeError
      Time.at(2**31 - 1)
    end
  end

  if victim.nil?
    UI.user_error!("Apple reported the Distribution certificate limit, but no valid Distribution certificate was available to revoke.")
  end

  label = victim.display_name.to_s.strip
  label = victim.name.to_s.strip if label.empty?
  label = victim.serial_number.to_s.strip if label.empty?
  label = victim.id.to_s if label.empty?

  UI.important("Revoking oldest Distribution certificate: #{label} (expires #{victim.expiration_date})")
  victim.delete!

  UI.message("Waiting 20 seconds for Apple's Developer Portal to release the certificate slot...")
  sleep(20)

  begin
    cert(**cert_options)
  rescue StandardError => retry_error
    raise unless cert_limit_error?(retry_error)

    UI.message("Apple still reports the certificate limit. Waiting another 40 seconds before the final retry...")
    sleep(40)
    cert(**cert_options)
  end
end

default_platform(:ios)

platform :ios do
  desc "Build Tiderun and upload it to TestFlight"
  lane :beta do
    key_id    = ENV["ASC_KEY_ID"].to_s.strip
    issuer_id = ENV["ASC_ISSUER_ID"].to_s.strip
    team_id   = ENV["APPLE_TEAM_ID"].to_s.strip

    UI.user_error!("ASC_KEY_ID is missing") if key_id.empty?
    UI.user_error!("ASC_ISSUER_ID is missing") if issuer_id.empty?
    UI.user_error!("APPLE_TEAM_ID is missing") if team_id.empty?

    raw = ENV["ASC_KEY_CONTENT"].to_s.strip
    key_text =
      if raw.include?("BEGIN PRIVATE KEY")
        raw
      else
        require "base64"
        Base64.decode64(raw)
      end

    unless key_text.include?("BEGIN PRIVATE KEY")
      UI.user_error!("ASC_KEY_CONTENT must contain the .p8 key or its base64 form")
    end

    key_path = File.expand_path("~/tiderun_asc_api_key.p8")
    File.write(key_path, key_text)

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path
    )

    keychain_name = "tiderun-ci.keychain"
    keychain_pw = "tiderun-ci-temp"
    create_keychain(
      name: keychain_name,
      password: keychain_pw,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    create_distribution_certificate!(
      api_key: api_key,
      keychain_name: keychain_name,
      keychain_pw: keychain_pw
    )

    sigh(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      force: true
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      path: "App.xcodeproj",
      use_automatic_signing: false,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      targets: ["App"]
    )

    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 0
    )
    next_build = latest + 1

    increment_version_number(
      xcodeproj: "App.xcodeproj",
      version_number: "0.1.0"
    )
    increment_build_number(
      xcodeproj: "App.xcodeproj",
      build_number: next_build
    )

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          APP_IDENTIFIER => profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
